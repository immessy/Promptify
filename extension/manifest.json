{
  "manifest_version": 3,
  "name": "Prompt Structuring",
  "version": "1.0",
  "description": "Structure rough ideas into proper AI agent prompts and docs.",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:5000/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Prompt Structuring Panel"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
