# Google Gemini API key for the free tier model fallback. Get one at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Host URL for local Ollama if not using the default localhost:11434
OLLAMA_HOST=http://localhost:11434

# Optional: Anthropic API key if you explicitly want to use Claude models
ANTHROPIC_API_KEY=
